diff --git a/src/include/hadoopfs_metadata_cache.hpp b/src/include/hadoopfs_metadata_cache.hpp
new file mode 100644
index 0000000..437b466
--- /dev/null
+++ b/src/include/hadoopfs_metadata_cache.hpp
@@ -0,0 +1,171 @@
+#pragma once
+// Process-wide cache of HDFS file metadata (status and located blocks) per path. Plain C++ (no DuckDB / libhdfs3
+// headers) so it can be unit tested without HDFS. Every NameNode round trip saved here matters on Kerberos/SASL
+// clusters: DuckDB opens a Parquet file several times per query (bind, footer, one handle per scan state).
+//
+// Rules: entries live ttl_ms after they were fetched (ttl is passed per call: it is a DuckDB setting); only successful
+// lookups are stored (never errors or "not found"); a fresh status with another length or mtime drops the cached
+// blocks; at most `capacity` paths (least recently used evicted).
+
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <list>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+namespace hadoopfs {
+
+struct CachedFileStatus {
+	bool is_dir = false;
+	int64_t length = 0;
+	int64_t mtime_ms = 0;
+	bool SameVersion(const CachedFileStatus &o) const {
+		return is_dir == o.is_dir && length == o.length && mtime_ms == o.mtime_ms;
+	}
+};
+
+class MetadataCache {
+public:
+	using Clock = std::function<int64_t()>; // monotonic ms
+	static int64_t SteadyMs() {
+		return std::chrono::duration_cast<std::chrono::milliseconds>(
+		           std::chrono::steady_clock::now().time_since_epoch())
+		    .count();
+	}
+
+	explicit MetadataCache(size_t capacity = 10000, Clock clock = SteadyMs)
+	    : capacity(capacity ? capacity : 1), clock(std::move(clock)) {
+	}
+
+	static MetadataCache &Instance() {
+		static MetadataCache cache;
+		return cache;
+	}
+
+	//! status of key if fetched less than ttl_ms ago
+	bool GetStatus(const std::string &key, int64_t ttl_ms, CachedFileStatus &out) {
+		if (ttl_ms <= 0) {
+			return false;
+		}
+		std::lock_guard<std::mutex> guard(lock);
+		auto entry = Find(key);
+		if (!entry || !entry->has_status || clock() - entry->status_time >= ttl_ms) {
+			status_misses++;
+			return false;
+		}
+		status_hits++;
+		out = entry->status;
+		return true;
+	}
+
+	//! a freshly fetched status; drops cached blocks of an older version of the file
+	void PutStatus(const std::string &key, const CachedFileStatus &status) {
+		std::lock_guard<std::mutex> guard(lock);
+		auto &entry = FindOrInsert(key);
+		if (entry.has_status && !entry.status.SameVersion(status)) {
+			entry.blocks.reset();
+		}
+		if (entry.blocks && !entry.blocks_status.SameVersion(status)) {
+			entry.blocks.reset();
+		}
+		entry.status = status;
+		entry.has_status = true;
+		entry.status_time = clock();
+	}
+
+	//! blocks fetched less than ttl_ms ago for exactly this version of the file (else null)
+	std::shared_ptr<void> GetBlocks(const std::string &key, int64_t ttl_ms, const CachedFileStatus &status) {
+		if (ttl_ms <= 0) {
+			return nullptr;
+		}
+		std::lock_guard<std::mutex> guard(lock);
+		auto entry = Find(key);
+		if (!entry || !entry->blocks || !entry->blocks_status.SameVersion(status) ||
+		    clock() - entry->blocks_time >= ttl_ms) {
+			block_misses++;
+			return nullptr;
+		}
+		block_hits++;
+		return entry->blocks;
+	}
+
+	//! blocks of the file version `status` (the caller only stores locations of finalized files)
+	void PutBlocks(const std::string &key, const CachedFileStatus &status, std::shared_ptr<void> blocks) {
+		std::lock_guard<std::mutex> guard(lock);
+		auto &entry = FindOrInsert(key);
+		if (entry.has_status && !entry.status.SameVersion(status)) {
+			return; // a newer status arrived meanwhile
+		}
+		entry.blocks = std::move(blocks);
+		entry.blocks_status = status;
+		entry.blocks_time = clock();
+	}
+
+	void Invalidate(const std::string &key) {
+		std::lock_guard<std::mutex> guard(lock);
+		auto it = map.find(key);
+		if (it != map.end()) {
+			lru.erase(it->second);
+			map.erase(it);
+		}
+	}
+
+	void Clear() {
+		std::lock_guard<std::mutex> guard(lock);
+		map.clear();
+		lru.clear();
+	}
+
+	size_t Size() {
+		std::lock_guard<std::mutex> guard(lock);
+		return map.size();
+	}
+
+	uint64_t status_hits = 0, status_misses = 0, block_hits = 0, block_misses = 0;
+
+private:
+	struct Entry {
+		std::string key;
+		bool has_status = false;
+		CachedFileStatus status;
+		int64_t status_time = 0;
+		std::shared_ptr<void> blocks;
+		CachedFileStatus blocks_status;
+		int64_t blocks_time = 0;
+	};
+	using List = std::list<Entry>;
+
+	Entry *Find(const std::string &key) {
+		auto it = map.find(key);
+		if (it == map.end()) {
+			return nullptr;
+		}
+		lru.splice(lru.begin(), lru, it->second);
+		return &*it->second;
+	}
+
+	Entry &FindOrInsert(const std::string &key) {
+		if (auto entry = Find(key)) {
+			return *entry;
+		}
+		lru.emplace_front();
+		lru.front().key = key;
+		map[key] = lru.begin();
+		while (map.size() > capacity) {
+			map.erase(lru.back().key);
+			lru.pop_back();
+		}
+		return lru.front();
+	}
+
+	size_t capacity;
+	Clock clock;
+	std::mutex lock;
+	List lru;
+	std::unordered_map<std::string, List::iterator> map;
+};
+
+} // namespace hadoopfs
