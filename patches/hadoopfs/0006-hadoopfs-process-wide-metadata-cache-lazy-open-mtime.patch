     void HadoopFileSystem::Truncate(FileHandle &handle, int64_t new_size)
     {
         auto &hfh = (HadoopFileHandle &)handle;
+        hadoopfs::MetadataCache::Instance().Invalidate(GetCacheKey(hfh.path));
