 src/include/hadoopfs.hpp                |  21 +++
 src/include/hadoopfs_metadata_cache.hpp | 171 ++++++++++++++++++++++++
 3 files changed, 333 insertions(+), 3 deletions(-)
 create mode 100644 src/include/hadoopfs_metadata_cache.hpp

