+    void HadoopFileSystem::EnsureOpen(HadoopFileHandle &hfh)
+    {
+        if (hfh.hdfs_file || !hfh.lazy_open)
+        {
+            return;
+        }
+        auto &cache = hadoopfs::MetadataCache::Instance();
+        auto blocks = cache.GetBlocks(hfh.cache_key, hfh.cache_ttl_ms, hfh.status);
+        if (!blocks)
+        {
+            tOffset file_length = 0;
+            int complete = 0;
+            // all blocks of the file in one call (the stream would otherwise fetch the ones past the first
+            // dfs.prefetchsize blocks, e.g. for the Parquet footer, with another NameNode call)
+            auto locations = hdfsGetBlockLocationsForRead(hfh.hdfs, hfh.hdfs_path.c_str(),
+                                                          MaxValue<int64_t>(hfh.status.length, 1), &file_length,
+                                                          &complete);
+            if (!locations)
+            {
+                const char *error = hdfsGetLastError();
+                throw IOException("Failed to open file \"%s\": %s", hfh.GetPath(), error ? error : "unknown error");
+            }
+            blocks = std::shared_ptr<void>(locations, [](void *l) { hdfsFreeBlockLocations(static_cast<hdfsBlockLocations>(l)); });
+            // only finalized files whose length matches the status: anything else is being written
+            if (complete && file_length == hfh.status.length)
+            {
+                cache.PutBlocks(hfh.cache_key, hfh.status, blocks);
+            }
+        }
+        hfh.hdfs_file = hdfsOpenFileWithBlockLocations(hfh.hdfs, hfh.hdfs_path.c_str(),
+                                                       static_cast<hdfsBlockLocations>(blocks.get()));
+        if (!hfh.hdfs_file)
+        {
+            const char *error = hdfsGetLastError();
+            cache.Invalidate(hfh.cache_key);
+            throw IOException("Failed to open file \"%s\": %s", hfh.GetPath(), error ? error : "unknown error");
+        }
+    }
+
+    int64_t HadoopFileSystem::GetMetadataCacheTtl(optional_ptr<FileOpener> opener)
+    {
+        Value value;
+        bool found = false;
+        if (opener)
+        {
+            found = FileOpener::TryGetCurrentSetting(opener, HDFSParams::HDFS_METADATA_CACHE_TTL_MS, value);
+        }
+        if (!found)
+        {
+            found = instance.TryGetCurrentSetting(HDFSParams::HDFS_METADATA_CACHE_TTL_MS, value);
+        }
+        if (!found || value.IsNull())
+        {
+            return 0;
+        }
+        try
+        {
+            return value.DefaultCastAs(LogicalType::BIGINT).GetValue<int64_t>();
+        }
+        catch (...)
+        {
+            return 0;
+        }
+    }
+
+    string HadoopFileSystem::GetCacheKey(const string &url)
+    {
+        string url_path;
+        HDFSParams url_params;
+        HadoopFileSystem::ParseUrl(url, url_path, url_params);
+        string namenode = url_params.namenode;
+        if (namenode == "default")
+        {
+            namenode = HDFSParams::ReadFrom(instance).namenode;
+        }
+        return namenode + url_path;
+    }
