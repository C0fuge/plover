From f0d81ea3e33f5cd75f147bb29a1c986a590d0761 Mon Sep 17 00:00:00 2001
From: C0fuge <189659128+C0fuge@users.noreply.github.com>
Date: Tue, 20 Oct 2026 13:49:08 +0300
Subject: [PATCH 2/3] hadoopfs: HDFS read/write errors are IOExceptions, never
 short reads

ReadFromHDFS(location) stopped at the first hdfsRead() result <= 0 and returned
the partial count, and Read(location) ignored it. A libhdfs3 read error (e.g. a
DataNode read timeout) therefore reached the Parquet reader as a half-filled
buffer: "No magic bytes found at end of file" / "Variable-length int over 10
bytes" instead of an I/O error.

Now:
- hdfsRead() == -1 -> IOException with hdfsGetLastError() (libhdfs3 has already
  tried the other replicas of the block at that point);
- positional Read() must return all requested bytes, else IOException
  ("unexpected end of file"), like DuckDB's local file system;
- lengths are clamped to 32 bit per hdfsRead/hdfsWrite call (tSize), the byte
  counters are 64 bit (were int);
- seek + read on one handle is serialised by a per-handle mutex;
- hdfsWrite() == -1 -> IOException (was silently dropped);
- "Unable to get file info" carries the libhdfs3 error instead of printing it
  to stdout.
---
 src/hadoopfs.cpp         | 69 ++++++++++++++++++++++++++++------------
 src/include/hadoopfs.hpp |  3 ++
 2 files changed, 51 insertions(+), 21 deletions(-)

diff --git a/src/hadoopfs.cpp b/src/hadoopfs.cpp
index bffb13e..5722807 100644
--- a/src/hadoopfs.cpp
+++ b/src/hadoopfs.cpp
@@ -588,8 +588,8 @@ namespace duckdb
             }
             else
             {
-                Printer::Print(hdfsGetLastError());
-                throw IOException("Unable to get file info: " + path);
+                const char *error = hdfsGetLastError();
+                throw IOException("Unable to get file info: " + path + ": " + string(error ? error : "unknown error"));
             }
         }
         else
@@ -646,38 +646,61 @@ namespace duckdb
 
     void HadoopFileSystem::Read(FileHandle &handle, void *buffer, int64_t nr_bytes, idx_t location)
     {
-        ReadFromHDFS(handle, buffer, nr_bytes, location);
+        // DuckDB expects a positional Read to fill the whole buffer. A short read here used to reach the
+        // Parquet reader as garbage ("No magic bytes found at end of file", "Variable-length int over 10 bytes").
+        auto read_byte_count = ReadFromHDFS(handle, buffer, nr_bytes, location);
+        if (read_byte_count != nr_bytes)
+        {
+            throw IOException("Could not read all bytes from HDFS file \"%s\": wanted %s bytes at offset %s, got %s "
+                              "(unexpected end of file)",
+                              handle.GetPath(), to_string(nr_bytes), to_string(location), to_string(read_byte_count));
+        }
     }
 
     int64_t HadoopFileSystem::Read(FileHandle &handle, void *buffer, int64_t nr_bytes)
     {
+        auto &hfh = handle.Cast<HadoopFileHandle>();
+        lock_guard<mutex> guard(hfh.io_lock);
         return ReadFromHDFS(handle, buffer, nr_bytes);
     }
 
+    // One hdfsRead call. Returns the byte count (0 = end of file); a failed read is an IOException,
+    // never a short count. libhdfs3 has already tried the other replicas of the block when this fails.
     int64_t HadoopFileSystem::ReadFromHDFS(FileHandle &handle, void *buffer, int64_t nr_bytes)
     {
-        auto &hfh = (HadoopFileHandle &)handle;
-        auto length = hdfsRead(hfh.hdfs, hfh.hdfs_file, buffer, nr_bytes);
+        auto &hfh = handle.Cast<HadoopFileHandle>();
+        if (nr_bytes <= 0)
+        {
+            return 0;
+        }
+        // hdfsRead takes a 32-bit length
+        auto chunk = static_cast<tSize>(MinValue<int64_t>(nr_bytes, NumericLimits<int32_t>::Maximum()));
+        auto length = hdfsRead(hfh.hdfs, hfh.hdfs_file, buffer, chunk);
+        if (length < 0)
+        {
+            const char *error = hdfsGetLastError();
+            throw IOException("Failed to read from HDFS file \"%s\" at offset %s: %s", handle.GetPath(),
+                              to_string(hdfsTell(hfh.hdfs, hfh.hdfs_file)), error ? error : "unknown error");
+        }
         return length;
     }
 
     int64_t HadoopFileSystem::ReadFromHDFS(FileHandle &handle, void *buffer, int64_t nr_bytes, idx_t location)
     {
-        auto &hfh = dynamic_cast<HadoopFileHandle &>(handle);
+        auto &hfh = handle.Cast<HadoopFileHandle>();
+        // seek + read on one libhdfs3 stream must not interleave between threads
+        lock_guard<mutex> guard(hfh.io_lock);
         Seek(handle, location);
-        auto read_byte_count = 0;
+        int64_t read_byte_count = 0;
         while (read_byte_count < nr_bytes)
         {
             void *offset_buffer = static_cast<char *>(buffer) + read_byte_count;
             auto length = ReadFromHDFS(handle, offset_buffer, nr_bytes - read_byte_count);
-            if (length > 0)
+            if (length == 0)
             {
-                read_byte_count += length;
-            }
-            else
-            {
-                break;
+                break; // end of file
             }
+            read_byte_count += length;
         }
         return read_byte_count;
     }
@@ -686,19 +709,16 @@ namespace duckdb
     {
         auto offset = location - SeekPosition(handle);
         Seek(handle, offset);
-        auto write_byte_count = 0;
+        int64_t write_byte_count = 0;
         while (write_byte_count < nr_bytes)
         {
             void *offset_buffer = static_cast<char *>(buffer) + write_byte_count;
             auto length = Write(handle, offset_buffer, nr_bytes - write_byte_count);
-            if (length >= 0)
-            {
-                write_byte_count += length;
-            }
-            else
+            if (length <= 0)
             {
-                break;
+                throw IOException("Could not write all bytes to HDFS file \"%s\"", handle.GetPath());
             }
+            write_byte_count += length;
         }
     }
 
@@ -709,7 +729,14 @@ namespace duckdb
         {
             throw InternalException("Write called on file not opened in write mode");
         }
-        return hdfsWrite(hfh.hdfs, hfh.hdfs_file, buffer, nr_bytes);
+        auto chunk = static_cast<tSize>(MinValue<int64_t>(nr_bytes, NumericLimits<int32_t>::Maximum()));
+        auto length = hdfsWrite(hfh.hdfs, hfh.hdfs_file, buffer, chunk);
+        if (length < 0)
+        {
+            const char *error = hdfsGetLastError();
+            throw IOException("Failed to write to HDFS file \"%s\": %s", handle.GetPath(), error ? error : "unknown error");
+        }
+        return length;
     }
 
     void HadoopFileSystem::FileSync(FileHandle &handle)
diff --git a/src/include/hadoopfs.hpp b/src/include/hadoopfs.hpp
index 28b001c..1219222 100644
--- a/src/include/hadoopfs.hpp
+++ b/src/include/hadoopfs.hpp
@@ -4,6 +4,7 @@
 #include "duckdb/common/file_opener.hpp"
 #include "duckdb/main/config.hpp"
 #include "duckdb/main/client_data.hpp"
+#include "duckdb/common/mutex.hpp"
 
 #include <hdfs/hdfs.h>
 
@@ -134,6 +135,8 @@ namespace duckdb
         FileType file_type = FileType::FILE_TYPE_INVALID;
 
         idx_t length;
+        //! serialises seek + read on the libhdfs3 stream
+        mutex io_lock;
         timestamp_t last_modified{};
 
     public:
