+++ b/src/client/RemoteBlockReader.cpp
@@ -74,7 +74,7 @@ RemoteBlockReader::RemoteBlockReader(const ExtendedBlock& eb,
     std::string qops = DataTransferProtectionToQops(conf.getDataTransferProtection());
     if (!sockFromCache && DataTransferNeedsSasl(qops, token, datanode.getXferPort())) {
         try {
-            sock = DataTransferSaslConnect(sock, token, qops, readTimeout, writeTimeout, datanode.formatAddress());
+            sock = DataTransferSaslConnect(sock, token, qops, conf.getDataTransferCipherSuites(), readTimeout, writeTimeout, datanode.formatAddress());
         } catch (...) {
             sock->close();
             throw;
