diff --git a/src/proto/datatransfer.proto b/src/proto/datatransfer.proto
index 3de6c4b..6b74aa9 100644
--- a/src/proto/datatransfer.proto
+++ b/src/proto/datatransfer.proto
@@ -34,6 +34,27 @@ package Hdfs.Internal;
 import "Security.proto";
 import "hdfs.proto";
 
+/**
+ * Cipher suite of the data-transfer cipher option (Hadoop: hdfs.proto CipherSuiteProto)
+ */
+enum CipherSuiteProto {
+    CIPHER_SUITE_UNKNOWN = 1;  // Hadoop: UNKNOWN (renamed: enum values are package scope in C++)
+    AES_CTR_NOPADDING = 2;
+    SM4_CTR_NOPADDING = 3;
+}
+
+/**
+ * Cipher option negotiated in the data-transfer SASL handshake (dfs.encrypt.data.transfer.cipher.suites);
+ * the DataNode sends the keys SASL-wrapped (auth-conf), the IVs in the clear
+ */
+message CipherOptionProto {
+  required CipherSuiteProto suite = 1;
+  optional bytes inKey = 2;
+  optional bytes inIv = 3;
+  optional bytes outKey = 4;
+  optional bytes outIv = 5;
+}
+
 message DataTransferEncryptorMessageProto {
   enum DataTransferEncryptorStatus {
     SUCCESS = 0;
@@ -43,6 +64,7 @@ message DataTransferEncryptorMessageProto {
   required DataTransferEncryptorStatus status = 1;
   optional bytes payload = 2;
   optional string message = 3;
+  repeated CipherOptionProto cipherOption = 4;
 }
 
