+#ifndef _HDFS_LIBHDFS3_RPC_DIGESTMD5CLIENT_H_
+#define _HDFS_LIBHDFS3_RPC_DIGESTMD5CLIENT_H_
+
+#include <stdexcept>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+namespace Hdfs {
+namespace Internal {
+
+class DigestMd5Error : public std::runtime_error {
+public:
+    explicit DigestMd5Error(const std::string & what) : std::runtime_error(what) {}
+};
+
+/**
+ * SASL DIGEST-MD5 client (RFC 2831) with all three QOPs: auth, auth-int (HMAC-MD5 integrity) and
+ * auth-conf (confidentiality with 3des / des / rc4 / rc4-56 / rc4-40, as the JDK's DigestMD5 does).
+ * libgsasl's DIGEST-MD5 has no auth-conf (it refuses qop=auth-conf), which HDFS data transfer with
+ * dfs.data.transfer.protection=privacy needs; this class needs only OpenSSL libcrypto.
+ *
+ * Usage: response = evaluateChallenge(challenge); evaluateChallenge(rspauth) (verifies the server,
+ * returns ""); then isComplete(), qop(), wrap() / unwrap(). Not thread safe (sequence numbers and
+ * cipher state are per direction, as in the JDK: one writer and one reader at a time).
+ */
+class DigestMd5Client {
+public:
+    /**
+     * @param username the SASL user name (for a block token: base64 of the token identifier)
+     * @param password the password (for a block token: base64 of the token password)
+     * @param protocol e.g. "hdfs"; with serverName forms digest-uri "protocol/serverName"
+     * @param serverName e.g. "0" for DataNode data transfer
+     * @param qops client QOP preference, comma separated, out of auth-conf, auth-int, auth
+     * @param ciphers cipher preference for auth-conf, comma separated, out of 3des, rc4, des, rc4-56, rc4-40
+     */
+    DigestMd5Client(const std::string & username, const std::string & password,
+                    const std::string & protocol, const std::string & serverName,
+                    const std::string & qops = "auth-conf,auth-int,auth",
+                    const std::string & ciphers = "3des,rc4,des,rc4-56,rc4-40");
+    ~DigestMd5Client();
+
+    std::string evaluateChallenge(const std::string & challenge);
+
+    bool isComplete() const {
+        return complete;
+    }
+
+    /** negotiated QOP: "auth", "auth-int" or "auth-conf" (valid after the first step) */
+    const std::string & qop() const {
+        return chosenQop;
+    }
+
+    /** negotiated cipher for auth-conf, "" otherwise */
+    const std::string & cipher() const {
+        return chosenCipher;
+    }
+
+    /** true if wrap/unwrap transform data (auth-int or auth-conf) */
+    bool isWrapping() const {
+        return complete && chosenQop != "auth";
+    }
+
+    /** the largest plain message wrap() may be given so that the wrapped token fits the server's maxbuf */
+    size_t maxRawSendSize() const;
+
+    std::string wrap(const char * data, size_t len);
+    std::string unwrap(const char * data, size_t len);
+
+    /** for tests: fixed client nonce instead of a random one */
+    void setCnonce(const std::string & c) {
+        cnonce = c;
+    }
+
+private:
+    DigestMd5Client(const DigestMd5Client &);
+    DigestMd5Client & operator=(const DigestMd5Client &);
+
+    std::string firstStep(const std::string & challenge);
+    void secondStep(const std::string & challenge);
+    std::string responseValue(const std::string & a2) const;
+    void deriveKeys();
+
+    std::string username, password, digestUri;
+    std::vector<std::string> qopPref, cipherPref;
+    std::string realm, nonce, cnonce, chosenQop, chosenCipher, expectedRspauth;
+    bool utf8;
+    size_t serverMaxbuf;
+    int step;
+    bool complete;
+    unsigned char ha1[16];
+    unsigned char kic[16], kis[16], kcc[16], kcs[16];
+    uint32_t sendSeq, recvSeq;
+    void * encCtx; // EVP_CIPHER_CTX
+    void * decCtx;
+    int blockSize;
+};
+
+}
+}
+
+#endif /* _HDFS_LIBHDFS3_RPC_DIGESTMD5CLIENT_H_ */
