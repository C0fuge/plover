+/*
+ * Process-wide dead DataNode list (see DeadNodes.h): a node whose remote block reader failed is avoided by every
+ * stream for input.deadnode.ttl ms instead of only for the current block of the current stream.
+ */
+static std::string deadNodeKey(const DatanodeInfo & node) {
+    return node.getDatanodeId() + "@" + node.getXferAddr();
+}
+
+static void rememberDeadNode(const DatanodeInfo & node, const SessionConfig & conf) {
+    int32_t ttl = conf.getDeadNodeTtl();
+
+    if (ttl > 0 && DeadNodes::instance().markDead(deadNodeKey(node), ttl)) {
+        LOG(WARNING, "InputStreamImpl: Datanode %s failed, other replicas are preferred for the next %d ms.",
+            node.formatAddress().c_str(), ttl);
+    }
+}
+
+static void forgetDeadNode(const DatanodeInfo & node) {
+    if (DeadNodes::instance().size() > 0 && DeadNodes::instance().markAlive(deadNodeKey(node))) {
+        LOG(INFO, "InputStreamImpl: Datanode %s answered again, removed from the dead node list.",
+            node.formatAddress().c_str());
+    }
+}
