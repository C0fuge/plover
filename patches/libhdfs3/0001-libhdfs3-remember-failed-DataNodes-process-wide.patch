diff --git a/src/client/DeadNodes.cpp b/src/client/DeadNodes.cpp
new file mode 100644
index 0000000..281faef
--- /dev/null
+++ b/src/client/DeadNodes.cpp
@@ -0,0 +1,78 @@
+/*
+ * Process-wide dead DataNode list with expiry (afc patch). Without it libhdfs3 forgets a failed DataNode at every
+ * block (InputStreamImpl::seekToBlock clears failedNodes) and in every new stream, so while a DataNode is silently
+ * lost each read that the namenode orders to it first pays the connect/read timeout again.
+ */
+#include "DeadNodes.h"
+
+namespace Hdfs {
+namespace Internal {
+
+DeadNodes & DeadNodes::instance() {
+    static DeadNodes * nodes = new DeadNodes();  // never destroyed: used by streams closed during exit
+    return *nodes;
+}
+
+bool DeadNodes::markDead(const std::string & key, int64_t ttlMs, Clock::time_point now) {
+    if (ttlMs <= 0) {
+        return false;
+    }
+
+    Clock::time_point until = now + std::chrono::milliseconds(ttlMs);
+    std::lock_guard<std::mutex> lock(mu);
+    auto it = expiry.find(key);
+
+    if (it == expiry.end()) {
+        expiry.emplace(key, until);
+        count.store(expiry.size(), std::memory_order_relaxed);
+        return true;
+    }
+
+    bool wasAlive = it->second <= now;
+    if (it->second < until) {
+        it->second = until;
+    }
+
+    return wasAlive;
+}
+
+bool DeadNodes::isDead(const std::string & key, Clock::time_point now) {
+    if (size() == 0) {
+        return false;
+    }
+
+    std::lock_guard<std::mutex> lock(mu);
+    auto it = expiry.find(key);
+
+    if (it == expiry.end()) {
+        return false;
+    }
+
+    if (it->second <= now) {
+        expiry.erase(it);
+        count.store(expiry.size(), std::memory_order_relaxed);
+        return false;
+    }
+
+    return true;
+}
+
+bool DeadNodes::markAlive(const std::string & key) {
+    if (size() == 0) {
+        return false;
+    }
+
+    std::lock_guard<std::mutex> lock(mu);
+    bool found = expiry.erase(key) > 0;
+    count.store(expiry.size(), std::memory_order_relaxed);
+    return found;
+}
+
+void DeadNodes::clear() {
+    std::lock_guard<std::mutex> lock(mu);
+    expiry.clear();
+    count.store(0, std::memory_order_relaxed);
+}
+
+}
+}
diff --git a/src/client/DeadNodes.h b/src/client/DeadNodes.h
new file mode 100644
index 0000000..6731805
--- /dev/null
+++ b/src/client/DeadNodes.h
@@ -0,0 +1,86 @@
+/*
+ * Process-wide memory of DataNodes that recently failed (afc patch, see DeadNodes.cpp).
+ */
+#ifndef _HDFS_LIBHDFS3_CLIENT_DEADNODES_H_
+#define _HDFS_LIBHDFS3_CLIENT_DEADNODES_H_
+
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+namespace Hdfs {
+namespace Internal {
+
+/**
+ * DataNodes whose remote block reader failed (connect / read timeout, IO error) are remembered for a TTL
+ * ("input.deadnode.ttl", ms) by every input stream of the process, not only for the current block of one stream:
+ * while a DataNode is silently gone (and the namenode still lists it), each new block, seek or file would otherwise
+ * try it first again and pay a full connect/read timeout. Replica choice prefers nodes that are not remembered as
+ * dead; a dead one is still used when it is the only replica left. A successful block reader setup on a node
+ * forgets it at once. Key = DataNode UUID + "@" + ip:xferPort (a node that comes back with a new address is new).
+ */
+class DeadNodes {
+public:
+    typedef std::chrono::steady_clock Clock;
+
+    static DeadNodes & instance();
+
+    /** remember key as dead until now + ttlMs (ttlMs <= 0: no-op). Returns true if it was not dead before. */
+    bool markDead(const std::string & key, int64_t ttlMs, Clock::time_point now = Clock::now());
+
+    /** true if key failed less than its TTL ago (expired entries are dropped). */
+    bool isDead(const std::string & key, Clock::time_point now = Clock::now());
+
+    /** forget key (called after a successful block reader setup). Returns true if it was remembered. */
+    bool markAlive(const std::string & key);
+
+    /** number of remembered entries (expired ones included until looked up). */
+    size_t size() const {
+        return count.load(std::memory_order_relaxed);
+    }
+
+    void clear();
+
+    /**
+     * Replica choice: index of the first node that is not failed for this read and not remembered as dead; else the
+     * first node that is not failed (dead, but the only choice left); else -1.
+     * isFailed(i) = node i already failed for the current block; keyOf(i) = its dead-node key.
+     */
+    template <typename IsFailed, typename KeyOf>
+    int choose(size_t n, IsFailed isFailed, KeyOf keyOf, bool consult, Clock::time_point now = Clock::now()) {
+        int fallback = -1;
+        bool any = consult && size() > 0;
+
+        for (size_t i = 0; i < n; ++i) {
+            if (isFailed(i)) {
+                continue;
+            }
+
+            if (any && isDead(keyOf(i), now)) {
+                if (fallback < 0) {
+                    fallback = static_cast<int>(i);
+                }
+
+                continue;
+            }
+
+            return static_cast<int>(i);
+        }
+
+        return fallback;
+    }
+
+private:
+    mutable std::mutex mu;
+    std::unordered_map<std::string, Clock::time_point> expiry;
+    std::atomic<size_t> count{0};
+};
+
+}
+}
+
+#endif /* _HDFS_LIBHDFS3_CLIENT_DEADNODES_H_ */
