+/**
+ * Data-transfer protection negotiated with one DataNode (patch): what the process's remote block readers set up on
+ * their new connections to it (dfs.data.transfer.protection / dfs.encrypt.data.transfer.cipher.suites).
+ */
+typedef struct {
+    char * datanode;     /* "host(ip):xferPort" */
+    char * qop;          /* last negotiated: "auth", "auth-int", "auth-conf"; "none" = plain connection without SASL */
+    char * cipher;       /* "AES/CTR/NoPadding", the DIGEST-MD5 cipher ("3des", "rc4", ...) or "" (not encrypted) */
+    int keyBits;         /* AES key length, else 0 */
+    int64_t connections; /* new connections (pooled re-uses not counted) */
+    int64_t failures;    /* failed SASL handshakes */
+    int64_t firstMs;     /* unix ms of the first record */
+    int64_t lastMs;      /* unix ms of the last successful connection, 0 if none */
+    char * lastError;    /* last handshake error or "" */
+} hdfsDataTransferInfo;
+
+/**
+ * hdfsGetDataTransferInfo - process-wide snapshot, one entry per DataNode (all filesystems of the process).
+ * @param numEntries out: number of entries.
+ * @return the array (free with hdfsFreeDataTransferInfo), NULL with *numEntries = 0 if there is none or on error.
+ */
+hdfsDataTransferInfo * hdfsGetDataTransferInfo(int * numEntries);
+
+void hdfsFreeDataTransferInfo(hdfsDataTransferInfo * info, int numEntries);
+
