diff --git a/src/client/TransferInfo.cpp b/src/client/TransferInfo.cpp
new file mode 100644
index 0000000..8b43f17
--- /dev/null
+++ b/src/client/TransferInfo.cpp
@@ -0,0 +1,80 @@
+/*
+ * afc patch: process-wide record of the negotiated data-transfer QOP / cipher per DataNode (TransferInfo.h).
+ */
+#include "TransferInfo.h"
+
+#include <chrono>
+
+namespace Hdfs {
+namespace Internal {
+
+static int64_t NowMs() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+TransferInfo & TransferInfo::instance() {
+    static TransferInfo * info = new TransferInfo(); // never destroyed: readers may run during exit
+    return *info;
+}
+
+TransferInfoEntry * TransferInfo::get(const std::string & datanode, bool & isNew) {
+    auto it = entries.find(datanode);
+    isNew = it == entries.end();
+    if (!isNew) {
+        return &it->second;
+    }
+    if (entries.size() >= maxEntries) {
+        return nullptr;
+    }
+    TransferInfoEntry & e = entries[datanode];
+    e.datanode = datanode;
+    e.firstMs = NowMs();
+    return &e;
+}
+
+bool TransferInfo::record(const std::string & datanode, const std::string & qop, const std::string & cipher,
+                          int keyBits) {
+    std::lock_guard<std::mutex> lock(mut);
+    bool isNew;
+    TransferInfoEntry * e = get(datanode, isNew);
+    if (!e) {
+        return false;
+    }
+    bool changed = isNew || e->connections == 0 || e->qop != qop || e->cipher != cipher || e->keyBits != keyBits;
+    e->qop = qop;
+    e->cipher = cipher;
+    e->keyBits = keyBits;
+    ++e->connections;
+    e->lastMs = NowMs();
+    return changed;
+}
+
+void TransferInfo::recordFailure(const std::string & datanode, const std::string & error) {
+    std::lock_guard<std::mutex> lock(mut);
+    bool isNew;
+    TransferInfoEntry * e = get(datanode, isNew);
+    if (!e) {
+        return;
+    }
+    ++e->failures;
+    e->lastError = error.substr(0, 1000);
+}
+
+std::vector<TransferInfoEntry> TransferInfo::snapshot() const {
+    std::lock_guard<std::mutex> lock(mut);
+    std::vector<TransferInfoEntry> out;
+    out.reserve(entries.size());
+    for (const auto & kv : entries) {
+        out.push_back(kv.second);
+    }
+    return out;
+}
+
+void TransferInfo::clear() {
+    std::lock_guard<std::mutex> lock(mut);
+    entries.clear();
+}
+
+}
+}
diff --git a/src/client/TransferInfo.h b/src/client/TransferInfo.h
new file mode 100644
index 0000000..35bbf72
--- /dev/null
+++ b/src/client/TransferInfo.h
@@ -0,0 +1,55 @@
+/*
+ * Process-wide record of the data-transfer protection negotiated with each DataNode (afc patch, see TransferInfo.cpp).
+ */
+#ifndef _HDFS_LIBHDFS3_CLIENT_TRANSFERINFO_H_
+#define _HDFS_LIBHDFS3_CLIENT_TRANSFERINFO_H_
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace Hdfs {
+namespace Internal {
+
+struct TransferInfoEntry {
+    std::string datanode;    // "host(ip):xferPort"
+    std::string qop;         // last negotiated: "auth", "auth-int", "auth-conf", or "none" (plain connection, no SASL)
+    std::string cipher;      // "AES/CTR/NoPadding", the DIGEST-MD5 cipher ("3des", "rc4", ...) or "" (no encryption)
+    int keyBits = 0;         // AES key length, 0 otherwise
+    int64_t connections = 0; // new connections set up (pooled re-uses not counted)
+    int64_t failures = 0;    // SASL handshakes that failed
+    int64_t firstMs = 0;     // unix ms of the first record
+    int64_t lastMs = 0;      // unix ms of the last successful connection (0: none yet)
+    std::string lastError;   // message of the last failed handshake
+};
+
+/**
+ * Every new connection of a remote block reader records here what was negotiated with its DataNode (one entry per
+ * DataNode, the last negotiation wins, counters add up), so a caller can prove which QOP / cipher its reads use
+ * (C API hdfsGetDataTransferInfo). Bounded: at most maxEntries DataNodes (further ones are not recorded).
+ * record() returns true when the entry is new or its qop/cipher changed (the caller logs that once at INFO).
+ */
+class TransferInfo {
+public:
+    static TransferInfo & instance();
+
+    bool record(const std::string & datanode, const std::string & qop, const std::string & cipher, int keyBits);
+    void recordFailure(const std::string & datanode, const std::string & error);
+    std::vector<TransferInfoEntry> snapshot() const;
+    void clear();
+
+    static const size_t maxEntries = 10000;
+
+private:
+    TransferInfoEntry * get(const std::string & datanode, bool & isNew);
+
+    mutable std::mutex mut;
+    std::map<std::string, TransferInfoEntry> entries;
+};
+
+}
+}
+
+#endif /* _HDFS_LIBHDFS3_CLIENT_TRANSFERINFO_H_ */
