+hdfsDataTransferInfo * hdfsGetDataTransferInfo(int * numEntries) {
+    PARAMETER_ASSERT(numEntries, NULL, EINVAL);
+    *numEntries = 0;
+    hdfsDataTransferInfo * out = NULL;
+    int n = 0;
+    try {
+        std::vector<Hdfs::Internal::TransferInfoEntry> entries = Hdfs::Internal::TransferInfo::instance().snapshot();
+        if (entries.empty()) {
+            return NULL;
+        }
+        n = static_cast<int>(entries.size());
+        out = new hdfsDataTransferInfo[n](); // all pointers NULL: safe to free after a partial fill
+        for (int i = 0; i < n; ++i) {
+            const Hdfs::Internal::TransferInfoEntry & e = entries[i];
+            hdfsDataTransferInfo & o = out[i];
+            o.datanode = Strdup(e.datanode.c_str());
+            o.qop = Strdup(e.qop.c_str());
+            o.cipher = Strdup(e.cipher.c_str());
+            o.lastError = Strdup(e.lastError.c_str());
+            o.keyBits = e.keyBits;
+            o.connections = e.connections;
+            o.failures = e.failures;
+            o.firstMs = e.firstMs;
+            o.lastMs = e.lastMs;
+        }
+        *numEntries = n;
+        return out;
+    } catch (const std::bad_alloc & e) {
+        hdfsFreeDataTransferInfo(out, out ? n : 0);
+        SetErrorMessage("Out of memory");
+        errno = ENOMEM;
+    } catch (...) {
+        hdfsFreeDataTransferInfo(out, out ? n : 0);
+        SetLastException(Hdfs::current_exception());
+        handleException(Hdfs::current_exception());
+    }
+    return NULL;
+}
+
+void hdfsFreeDataTransferInfo(hdfsDataTransferInfo * info, int numEntries) {
+    if (!info) {
+        return;
+    }
+    for (int i = 0; i < numEntries; ++i) {
+        delete[] info[i].datanode;
+        delete[] info[i].qop;
+        delete[] info[i].cipher;
+        delete[] info[i].lastError;
+    }
+    delete[] info;
+}
+
 int hdfsCloseFile(hdfsFS fs, hdfsFile file) {
     PARAMETER_ASSERT(fs, -1, EINVAL);
 
