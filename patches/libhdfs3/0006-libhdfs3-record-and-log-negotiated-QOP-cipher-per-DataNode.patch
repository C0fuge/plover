     return msg.payload();
 }
 
+// Record the negotiation (TransferInfo) and log it at INFO: always (also without HDFS_ENABLE_LOGGING=true) the first
+// time per DataNode and when its qop/cipher changes, else (every further new connection) through the normal gated log.
+// Line format kept from afc6..afc8 ("DataTransferSasl: DataNode <dn>: qop <qop>, cipher <cipher>"; AES: "qop auth-conf,
+// cipher option AES/CTR/NoPadding, key <n> bits").
+static void LogNegotiation(const std::string & datanode, const std::string & qop, const std::string & cipher,
+                           int keyBits) {
+    bool changed = TransferInfo::instance().record(datanode, qop, cipher, keyBits);
+    if (keyBits > 0) {
+        if (changed) {
+            LOG_ALWAYS(INFO, "DataTransferSasl: DataNode %s: qop %s, cipher option %s, key %d bits", datanode.c_str(),
+                       qop.c_str(), cipher.c_str(), keyBits);
+        } else {
+            LOG(INFO, "DataTransferSasl: DataNode %s: qop %s, cipher option %s, key %d bits", datanode.c_str(),
+                qop.c_str(), cipher.c_str(), keyBits);
+        }
+    } else if (changed) {
+        LOG_ALWAYS(INFO, "DataTransferSasl: DataNode %s: qop %s, cipher %s", datanode.c_str(), qop.c_str(),
+                   cipher.empty() ? "-" : cipher.c_str());
+    } else {
+        LOG(INFO, "DataTransferSasl: DataNode %s: qop %s, cipher %s", datanode.c_str(), qop.c_str(),
+            cipher.empty() ? "-" : cipher.c_str());
+    }
+}
+
