+#include "DataTransferSasl.h"
+
+#include "Exception.h"
+#include "ExceptionInternal.h"
+#include "Token.h"
+#include "WriteBuffer.h"
+#include "datatransfer.pb.h"
+
+#include <openssl/evp.h>
+
+#include <algorithm>
+#include <cstring>
+#include <vector>
+
+namespace Hdfs {
+namespace Internal {
+
+static const int32_t SASL_TRANSFER_MAGIC_NUMBER = static_cast<int32_t>(0xDEADBEEF);
+static const int32_t MAX_SASL_MESSAGE = 64 * 1024;
+static const int32_t MAX_SASL_FRAME = 16 * 1024 * 1024;
+
+static std::string Base64(const std::string & in) {
+    std::string out(4 * ((in.size() + 2) / 3) + 1, '\0');
+    int n = EVP_EncodeBlock(reinterpret_cast<unsigned char *>(&out[0]),
+                            reinterpret_cast<const unsigned char *>(in.data()), static_cast<int>(in.size()));
+    out.resize(n);
+    return out;
+}
+
+std::string DataTransferProtectionToQops(const std::string & protection) {
+    std::string qops, item;
+    for (size_t i = 0; i <= protection.size(); ++i) {
+        if (i == protection.size() || protection[i] == ',') {
+            item.erase(0, item.find_first_not_of(" \t"));
+            item.erase(item.find_last_not_of(" \t") + 1);
+            std::transform(item.begin(), item.end(), item.begin(), ::tolower);
+            const char * q = NULL;
+            if (item == "authentication") {
+                q = "auth";
+            } else if (item == "integrity") {
+                q = "auth-int";
+            } else if (item == "privacy") {
+                q = "auth-conf";
+            } else if (!item.empty()) {
+                THROW(HdfsIOException, "unknown dfs.data.transfer.protection value \"%s\" (authentication, integrity, privacy)",
+                      item.c_str());
+            }
+            if (q) {
+                qops += (qops.empty() ? "" : ",") + std::string(q);
+            }
+            item.clear();
+        } else {
+            item.push_back(protection[i]);
+        }
+    }
+    return qops;
+}
+
+bool DataTransferNeedsSasl(const std::string & qops, const Token & blockToken, int xferPort) {
+    return !qops.empty() && !blockToken.getIdentifier().empty() && xferPort >= 1024;
+}
+
+static void SendSaslMessage(Socket & sock, const std::string & payload, int writeTimeout) {
+    DataTransferEncryptorMessageProto msg;
+    msg.set_status(DataTransferEncryptorMessageProto_DataTransferEncryptorStatus_SUCCESS);
+    msg.set_payload(payload);
+    WriteBuffer buffer;
+    int size = msg.ByteSize();
+    buffer.writeVarint32(size);
+    char * b = buffer.alloc(size);
+    if (!msg.SerializeToArray(b, size)) {
+        THROW(HdfsIOException, "DataTransferSasl: cannot serialize the SASL message");
+    }
+    sock.writeFully(buffer.getBuffer(0), buffer.getDataSize(0), writeTimeout);
+}
+
+static std::string ReadSaslMessage(Socket & sock, int readTimeout, const std::string & datanode) {
+    uint32_t size = 0;
+    for (int shift = 0;; shift += 7) {
+        unsigned char c;
+        sock.readFully(reinterpret_cast<char *>(&c), 1, readTimeout);
+        size |= static_cast<uint32_t>(c & 0x7f) << shift;
+        if (!(c & 0x80)) {
+            break;
+        }
+        if (shift >= 28) {
+            THROW(HdfsIOException, "DataTransferSasl: bad message length from DataNode %s", datanode.c_str());
+        }
+    }
+    if (size == 0 || size > static_cast<uint32_t>(MAX_SASL_MESSAGE)) {
+        THROW(HdfsIOException, "DataTransferSasl: bad message length %u from DataNode %s (does it expect SASL?)",
+              size, datanode.c_str());
+    }
+    std::vector<char> buf(size);
+    sock.readFully(&buf[0], size, readTimeout);
+    DataTransferEncryptorMessageProto msg;
+    if (!msg.ParseFromArray(&buf[0], size)) {
+        THROW(HdfsIOException, "DataTransferSasl: cannot parse the SASL message from DataNode %s", datanode.c_str());
+    }
+    if (msg.status() == DataTransferEncryptorMessageProto_DataTransferEncryptorStatus_ERROR_UNKNOWN_KEY) {
+        THROW(HdfsIOException, "DataTransferSasl: DataNode %s: unknown key: %s", datanode.c_str(), msg.message().c_str());
+    }
+    if (msg.status() != DataTransferEncryptorMessageProto_DataTransferEncryptorStatus_SUCCESS) {
+        THROW(HdfsIOException, "DataTransferSasl: DataNode %s refused the SASL handshake: %s", datanode.c_str(),
+              msg.message().c_str());
+    }
+    return msg.payload();
+}
+
+shared_ptr<Socket> DataTransferSaslConnect(shared_ptr<Socket> sock, const Token & blockToken,
+                                           const std::string & qops, int readTimeout, int writeTimeout,
+                                           const std::string & datanode) {
+    shared_ptr<DigestMd5Client> sasl(new DigestMd5Client(Base64(blockToken.getIdentifier()),
+                                                         Base64(blockToken.getPassword()), "hdfs", "0", qops));
+    try {
+        char magic[4];
+        magic[0] = (SASL_TRANSFER_MAGIC_NUMBER >> 24) & 0xff;
+        magic[1] = (SASL_TRANSFER_MAGIC_NUMBER >> 16) & 0xff;
+        magic[2] = (SASL_TRANSFER_MAGIC_NUMBER >> 8) & 0xff;
+        magic[3] = SASL_TRANSFER_MAGIC_NUMBER & 0xff;
+        sock->writeFully(magic, 4, writeTimeout);
+        SendSaslMessage(*sock, std::string(), writeTimeout);
+        std::string challenge = ReadSaslMessage(*sock, readTimeout, datanode);
+        SendSaslMessage(*sock, sasl->evaluateChallenge(challenge), writeTimeout);
+        std::string rspauth = ReadSaslMessage(*sock, readTimeout, datanode);
+        sasl->evaluateChallenge(rspauth);
+    } catch (const DigestMd5Error & e) {
+        THROW(HdfsIOException, "DataTransferSasl: SASL handshake with DataNode %s failed: %s", datanode.c_str(), e.what());
+    }
+    if (!sasl->isComplete()) {
+        THROW(HdfsIOException, "DataTransferSasl: SASL handshake with DataNode %s did not complete", datanode.c_str());
+    }
+    if (!sasl->isWrapping()) {
+        return sock;
+    }
+    return shared_ptr<Socket>(new SaslSocket(sock, sasl, readTimeout, datanode));
+}
+
+SaslSocket::SaslSocket(shared_ptr<Socket> raw, shared_ptr<DigestMd5Client> sasl, int readTimeout,
+                       const std::string & datanode)
+    : raw(raw), sasl(sasl), readTimeout(readTimeout), datanode(datanode), rpos(0) {
+}
+
+void SaslSocket::fill(int timeout) {
+    while (rpos >= rbuf.size()) {
+        unsigned char len[4];
+        raw->readFully(reinterpret_cast<char *>(len), 4, timeout);
+        int32_t n = static_cast<int32_t>((static_cast<uint32_t>(len[0]) << 24) | (static_cast<uint32_t>(len[1]) << 16) |
+                                         (static_cast<uint32_t>(len[2]) << 8) | len[3]);
+        if (n < 0 || n > MAX_SASL_FRAME) {
+            THROW(HdfsIOException, "SaslSocket: bad frame length %d from DataNode %s", n, datanode.c_str());
+        }
+        std::string frame(n, '\0');
+        if (n) {
+            raw->readFully(&frame[0], n, timeout);
+        }
+        try {
+            rbuf = sasl->unwrap(frame.data(), frame.size());
+        } catch (const DigestMd5Error & e) {
+            THROW(HdfsIOException, "SaslSocket: data from DataNode %s: %s", datanode.c_str(), e.what());
+        }
+        rpos = 0;
+    }
+}
+
+int32_t SaslSocket::read(char * buffer, int32_t size) {
+    fill(readTimeout);
+    int32_t n = static_cast<int32_t>(std::min(static_cast<size_t>(size), rbuf.size() - rpos));
+    memcpy(buffer, rbuf.data() + rpos, n);
+    rpos += n;
+    return n;
+}
+
+void SaslSocket::readFully(char * buffer, int32_t size, int timeout) {
+    int32_t done = 0;
+    while (done < size) {
+        fill(timeout);
+        int32_t n = static_cast<int32_t>(std::min(static_cast<size_t>(size - done), rbuf.size() - rpos));
+        memcpy(buffer + done, rbuf.data() + rpos, n);
+        rpos += n;
+        done += n;
+    }
+}
+
+int32_t SaslSocket::write(const char * buffer, int32_t size) {
+    // a frame is all or nothing: write it fully
+    writeFully(buffer, size, readTimeout);
+    return size;
+}
+
+void SaslSocket::writeFully(const char * buffer, int32_t size, int timeout) {
+    size_t chunk = sasl->maxRawSendSize();
+    if (chunk == 0) {
+        THROW(HdfsIOException, "SaslSocket: DataNode %s maxbuf too small", datanode.c_str());
+    }
+    for (int32_t off = 0; off < size;) {
+        size_t n = std::min(chunk, static_cast<size_t>(size - off));
+        std::string token;
+        try {
+            token = sasl->wrap(buffer + off, n);
+        } catch (const DigestMd5Error & e) {
+            THROW(HdfsIOException, "SaslSocket: data to DataNode %s: %s", datanode.c_str(), e.what());
+        }
+        std::string frame(4, '\0');
+        uint32_t t = static_cast<uint32_t>(token.size());
+        frame[0] = (t >> 24) & 0xff;
+        frame[1] = (t >> 16) & 0xff;
+        frame[2] = (t >> 8) & 0xff;
+        frame[3] = t & 0xff;
+        frame += token;
+        raw->writeFully(frame.data(), static_cast<int32_t>(frame.size()), timeout);
+        off += static_cast<int32_t>(n);
+    }
+}
+
+void SaslSocket::connect(const char *, int, int) {
+    THROW(HdfsIOException, "SaslSocket: connect on a SASL socket");
+}
+
+void SaslSocket::connect(const char *, const char *, int) {
+    THROW(HdfsIOException, "SaslSocket: connect on a SASL socket");
+}
+
+void SaslSocket::connect(struct addrinfo *, const char *, const char *, int) {
+    THROW(HdfsIOException, "SaslSocket: connect on a SASL socket");
+}
+
+bool SaslSocket::poll(bool read, bool write, int timeout) {
+    if (read && rpos < rbuf.size()) {
+        return true;
+    }
+    return raw->poll(read, write, timeout);
+}
+
+void SaslSocket::setBlockMode(bool enable) {
+    raw->setBlockMode(enable);
+}
+
+void SaslSocket::setNoDelay(bool enable) {
+    raw->setNoDelay(enable);
+}
+
+void SaslSocket::setLingerTimeout(int timeout) {
+    raw->setLingerTimeout(timeout);
+}
+
+void SaslSocket::disableSigPipe() {
+    raw->disableSigPipe();
+}
+
+void SaslSocket::close() {
+    raw->close();
+}
+
+}
+}
