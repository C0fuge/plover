+#ifndef _HDFS_LIBHDFS3_CLIENT_DATATRANSFERSASL_H_
+#define _HDFS_LIBHDFS3_CLIENT_DATATRANSFERSASL_H_
+
+#include "Memory.h"
+#include "network/Socket.h"
+#include "rpc/DigestMd5Client.h"
+
+#include <string>
+
+namespace Hdfs {
+namespace Internal {
+
+class Token;
+
+/**
+ * dfs.data.transfer.protection value ("authentication", "integrity", "privacy", comma separated, in preference
+ * order) -> DIGEST-MD5 QOP list ("auth", "auth-int", "auth-conf"); "" if unset. Throws HdfsConfigInvalid-like
+ * HdfsIOException for an unknown value.
+ */
+std::string DataTransferProtectionToQops(const std::string & protection);
+
+/**
+ * True if a connection to a DataNode transfer port must do the SASL handshake, as Hadoop's
+ * SaslDataTransferClient: protection configured, a block token present, and a non-privileged port
+ * (a DataNode on a privileged port is trusted by its port, no SASL).
+ */
+bool DataTransferNeedsSasl(const std::string & qops, const Token & blockToken, int xferPort);
+
+/**
+ * Hadoop data-transfer SASL handshake (SaslDataTransferClient.doSaslHandshake) on a freshly connected
+ * socket: magic 0xDEADBEEF, DataTransferEncryptorMessageProto messages (varint delimited), DIGEST-MD5 with
+ * user base64(token identifier), password base64(token password), digest-uri "hdfs/0".
+ * Returns the socket to use from now on: the same one for QOP auth, a SaslSocket wrapping it for auth-int /
+ * auth-conf (frames of int32 length + wrapped token both ways, as SaslInputStream / SaslOutputStream).
+ */
+shared_ptr<Socket> DataTransferSaslConnect(shared_ptr<Socket> sock, const Token & blockToken,
+                                           const std::string & qops, int readTimeout, int writeTimeout,
+                                           const std::string & datanode);
+
+/**
+ * Socket decorator that wraps every write and unwraps every read with a negotiated DIGEST-MD5 session.
+ * read() returns bytes of at most one unwrapped frame; poll(read) is true while unwrapped bytes are buffered.
+ */
+class SaslSocket : public Socket {
+public:
+    SaslSocket(shared_ptr<Socket> raw, shared_ptr<DigestMd5Client> sasl, int readTimeout,
+               const std::string & datanode);
+
+    int32_t read(char * buffer, int32_t size);
+    void readFully(char * buffer, int32_t size, int timeout);
+    int32_t write(const char * buffer, int32_t size);
+    void writeFully(const char * buffer, int32_t size, int timeout);
+    void connect(const char * host, int port, int timeout);
+    void connect(const char * host, const char * port, int timeout);
+    void connect(struct addrinfo * paddr, const char * host, const char * port, int timeout);
+    bool poll(bool read, bool write, int timeout);
+    void setBlockMode(bool enable);
+    void setNoDelay(bool enable);
+    void setLingerTimeout(int timeout);
+    void disableSigPipe();
+    void close();
+
+private:
+    void fill(int timeout);
+
+    shared_ptr<Socket> raw;
+    shared_ptr<DigestMd5Client> sasl;
+    int readTimeout;
+    std::string datanode;
+    std::string rbuf;
+    size_t rpos;
+};
+
+}
+}
+
+#endif /* _HDFS_LIBHDFS3_CLIENT_DATATRANSFERSASL_H_ */
