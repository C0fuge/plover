# Pinned sources (fetched by scripts/*.sh; nothing is vendored). Sourced by bash.
# DuckDB: the DuckDB version comes from the workflow input / DUCKDB_VERSION (default v1.4.5, tag commit f31be57c18).
DUCKDB_REPO=https://github.com/duckdb/duckdb
# Extension: vincent-chang/duckdb-hdfs, commit "v1.4.1" (2025-11-03) = source of the v1.4.1 build (footer version 51b7220)
HADOOPFS_REPO=https://github.com/vincent-chang/duckdb-hdfs
HADOOPFS_COMMIT=51b7220e9ef0f7dcebfd2478710c585e844d4043
# Version string written into the extension footer: upstream commit + our patch level
HADOOPFS_EXT_VERSION=51b7220-afc1
# --- deps (changing anything below rebuilds the cached /opt/deps) ---
# libhdfs3: ClickHouse fork. 94a9ead = ceb428c (used by the v1.4.1 build) + "Fix HdfsTimeoutException not retried in
# setupBlockReader and EC createBlockReader" (merged to master as 28a9868, 2026-10-18)
LIBHDFS3_REPO=https://github.com/ClickHouse/libhdfs3
LIBHDFS3_COMMIT=94a9eadf79e5fcfb00dcfbb8f97e681b7b927a72
PROTOBUF_URL=https://github.com/protocolbuffers/protobuf/releases/download/v21.12/protobuf-cpp-3.21.12.tar.gz
PROTOBUF_SHA256=4eab9b524aa5913c6fffb20b2a8abf5ef7f95a80bc0701f3a6dbb4c607f73460
GSASL_URL=https://ftp.gnu.org/gnu/gsasl/libgsasl-1.10.0.tar.gz
GSASL_SHA256=f1b553384dedbd87478449775546a358d6f5140c15cccc8fb574136fdc77329f
